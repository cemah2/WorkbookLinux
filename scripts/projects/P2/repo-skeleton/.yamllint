extends: default
rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ["true", "false", "on"]
  comments:
    min-spaces-from-content: 1
  # compatibilité ansible-lint (sinon « { a: 1 } » et les commentaires
  # décalés sont refusés en --strict)
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  document-start: disable
ignore: |
  .terraform/
  ansible/inventory/
